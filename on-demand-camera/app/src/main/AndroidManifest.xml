<?xml version="1.0" encoding="utf-8"?>
<!--
  App gộp OnCam: 1 APK cho cả 2 vai trò. Quyền, service, receiver của từng vai trò nằm trong manifest của
  thư viện camera-node / viewer và được trộn vào đây. networkSecurityConfig (cho phép HTTP tới IP Tailscale)
  đặt ở đây vì là thuộc tính cấp ứng dụng; đường truyền đã được Tailscale mã hoá + header xác thực HMAC.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".OnCamApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnCam">

        <!-- Màn hình mở đầu: chọn vai trò lần đầu rồi chuyển sang giao diện Camera hoặc Máy xem. -->
        <activity
            android:name=".RootActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
