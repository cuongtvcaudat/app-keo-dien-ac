<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MQTT tới broker của camera + tải ảnh/video qua HTTP, đều trong mạng Tailscale. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Chỉ Android 9 trở xuống cần quyền này để lưu ảnh chụp vào Thư viện. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Phase 7: nói ra loa máy camera. Chỉ xin khi bấm "Bật nói chuyện"; micro chỉ mở trong phiên có bật nói. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!--
      Nhận cảnh báo (0.12, mặc định tắt): dịch vụ nền giữ kết nối tới camera + hiện thông báo kèm ảnh.
      specialUse: Android 14+ bắt buộc khai loại; app cài APK riêng, không lên Google Play.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Mở thẳng hộp thoại "bỏ tối ưu pin" để cảnh báo không bị trễ khi máy ngủ. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <!-- Chỉ dùng khi bấm "Quét mã QR" (thư viện quét tự hỏi quyền lúc đó). Máy không có camera vẫn cài được. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
      networkSecurityConfig: cho phép HTTP không mã hoá tới camera (http://100.x.y.z:8080).
      Đường truyền đã được Tailscale (WireGuard) mã hoá ở tầng mạng; luồng video còn bắt buộc header xác thực.
    -->
    <application
        android:name=".ViewerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnCamViewer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".alert.AlertWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Giữ kết nối MQTT tới camera của chính người dùng (qua VPN Tailscale) để nhận cảnh báo an ninh tức thì" />
        </service>

        <receiver
            android:name=".alert.BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Màn hình quét QR của zxing-android-embedded: mặc định nằm ngang, cho xoay theo tay cầm. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
    </application>

</manifest>
