    <!-- Hướng dẫn chống tắt app (ColorOS) -->
    <string name="guide_title">Chống tắt app (Oppo / ColorOS)</string>
    <string name="guide_intro">ColorOS tắt app chạy nền rất mạnh tay. Làm đủ 5 bước dưới đây để camera node chạy 24/7. Tên mục có thể khác đôi chút giữa ColorOS 11, 12 và 13.</string>
    <string name="guide_step1_title">1. Bỏ tối ưu pin</string>
    <string name="guide_step1_todo">Chưa làm. Bấm nút dưới và chọn “Cho phép”.</string>
    <string name="guide_step1_done">✅ Đã bỏ tối ưu pin.</string>
    <string name="guide_step1_button">Bỏ tối ưu pin</string>
    <string name="guide_step2_title">2. Cho phép chạy nền và tự khởi chạy</string>
    <string name="guide_step2_body">Mở Thông tin ứng dụng → Mức sử dụng pin (hoặc Pin) → bật “Cho phép hoạt động ở nền”, “Cho phép hoạt động ở nền trước” và “Cho phép tự khởi chạy”.</string>
    <string name="guide_open_app_settings">Mở thông tin ứng dụng</string>
    <string name="guide_step3_title">3. Khoá app trong đa nhiệm</string>
    <string name="guide_step3_body">Mở màn hình đa nhiệm (vuốt từ dưới lên và giữ), chạm vào dấu ⋮ hoặc nhấn giữ thẻ OnCam Quay → chọn “Khoá”. Khi đó nút “Dọn tất cả” sẽ không tắt app.</string>
    <string name="guide_step4_title">4. Làm tương tự cho Tailscale</string>
    <string name="guide_step4_body">Lặp lại bước 1–3 cho app Tailscale. Thêm: Cài đặt → Kết nối khác → VPN → Tailscale → bật “VPN luôn bật”. Thiếu bước này, khởi động lại máy là camera mất kết nối.</string>
    <string name="guide_step5_title">5. Nguồn điện và nhiệt</string>
    <string name="guide_step5_body">Cắm sạc liên tục, đặt máy nơi thoáng và tránh nắng trực tiếp. Cắm sạc lâu ngày làm pin chai/phồng; kiểm tra pin định kỳ.</string>
