  "lines": [
    { "text": "{ngay}",       "size": 1.05 },
    { "text": "{lat} {lon}",  "size": 1.0, "required": ["lat"] },
    { "text": "{phuong}",     "size": 1.0, "required": ["phuong"] },
    { "text": "{tinh}",       "size": 1.0, "required": ["tinh"] },
    { "text": "{ma_tram}",    "size": 1.0, "required": ["ma_tram"] }
  ],

  "compass": { "enabled": false },

  "map": {
    "enabled": true,
    "corner": "bottom-left",
