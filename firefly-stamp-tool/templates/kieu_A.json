  "text": {
    "align": "left",
    "anchor": "bottom-left",
    "pad_x_frac": 0.155,
    "pad_bottom_frac": 0.020,
    "font_size_frac": 0.042,
    "line_spacing": 1.16,
    "color": [255, 255, 255],
    "shadow": { "enabled": true, "color": [0, 0, 0], "opacity": 0.75, "offset_frac": 0.003, "blur": 4 },
    "stroke": { "enabled": false, "color": [0, 0, 0], "width_frac": 0.002 }
